{
  "name": "eth-prices",
  "version": "0.0.10",
  "type": "module",
  "description": "Pure TypeScript price routing and quoting for EVM assets",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/v3xlabs/eth-prices.git",
    "directory": "ts"
  },
  "author": {
    "name": "v3xlabs",
    "url": "https://github.com/v3xlabs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "test:package": "pnpm build && node scripts/package-smoke.mjs",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "prepack": "pnpm build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "LGPL-3.0",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^25.5.0",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-sonarjs": "^4.1.0",
    "eslint-plugin-tailwindcss": "4.0.0-beta.0",
    "eslint-plugin-unicorn": "^70.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-v3xlabs": "^1.7.14",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.62.1",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.15.0",
  "pnpm": {
    "overrides": {
      "eslint-plugin-tailwindcss": "4.0.0-beta.0"
    }
  },
  "dependencies": {
    "ox": "^0.14.30"
  }
}
